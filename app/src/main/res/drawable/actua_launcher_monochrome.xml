<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android uses the source alpha as a single-color Material You mask. -->
    <item
        android:width="40dp"
        android:height="35dp"
        android:bottom="4dp"
        android:gravity="center">
        <bitmap android:antialias="true" android:filter="true" android:gravity="fill"
            android:src="@drawable/actua_mark" />
    </item>
</layer-list>
